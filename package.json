{
  "name": "@citation-js/plugin-isbn",
  "version": "0.4.0",
  "type": "module",
  "description": "Citation.js plugin to fetch ISBN metadata",
  "main": "src/index.js",
  "types": "index.d.ts",
  "scripts": {
    "test": "node --test --test-reporter spec --experimental-test-module-mocks test/suite.js",
    "lint": "standard \"src/**/*.js\" \"test/**/*.js\"",
    "type-check": "tsc --noEmit test/types.ts",
    "changelog": "conventional-changelog -p angular && git add CHANGELOG.md",
    "coverage": "c8 npm test",
    "report": "c8 report --reporter=lcov",
    "preversion": "npm run lint && npm run type-check && npm run test",
    "version": "npm run changelog"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/citation-js/plugin-isbn.git"
  },
  "keywords": [
    "citation.js",
    "ISBN",
    "Google Books",
    "Open Library"
  ],
  "author": "Lars Willighagen (https://larsgw.github.io/)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/citation-js/plugin-isbn/issues"
  },
  "homepage": "https://github.com/citation-js/plugin-isbn#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "/src",
    "/index.d.ts"
  ],
  "dependencies": {
    "@citation-js/date": "^0.5.0",
    "@citation-js/name": "^0.4.2"
  },
  "devDependencies": {
    "@citation-js/core": "^0.9.0",
    "c8": "^12.0.0",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-angular": "^9.4.0",
    "mocha": "^12.0.0",
    "standard": "^17.0.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@citation-js/core": ">=0.9.0"
  }
}
